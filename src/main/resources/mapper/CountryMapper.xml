<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.kgromov.mappers.CountryMapper">
    <!-- It seems mybatis is smart enough to map columns to properties by decapitalize 1st letter -->
    <select id="findAll" resultType="org.kgromov.model.Country">
        SELECT * FROM country ORDER BY Code;
    </select>

    <select id="findById" resultType="org.kgromov.model.Country">
        SELECT * FROM country WHERE Code = #{id};
    </select>

</mapper>